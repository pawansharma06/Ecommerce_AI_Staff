# =============================================================
# ShopAI Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================

# ----- Application -----
APP_VERSION=1.0.0-SNAPSHOT
APP_ENV=local

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=shopai
POSTGRES_USER=shopai
POSTGRES_PASSWORD=change_me_strong_password

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Backend -----
BACKEND_PORT=8080
JWT_SECRET=change_me_at_least_32_chars_long_secret_key
JWT_EXPIRY_SECONDS=3600

# ----- Frontend -----
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost/api

# ----- LLM Providers (Phase 7) -----
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=

# ----- Shopify (Phase 3) -----
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_API_VERSION=2024-10
# SHOPIFY_WEBHOOK_SECRET=

# ----- WhatsApp (Phase 11) -----
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ----- Email (Phase 12) -----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ----- pgvector HNSW Tuning -----
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
PGVECTOR_HNSW_EF_SEARCH=40
